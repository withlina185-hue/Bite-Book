<?php
require_once __DIR__ . '/config/database.php';
require_once __DIR__ . '/includes/functions.php';

$categoryId = filter_input(INPUT_GET, 'category', FILTER_VALIDATE_INT);
$categories = $pdo->query("SELECT category_id, category_name FROM categories ORDER BY category_name")->fetchAll();

$sql = "SELECT mi.item_id, mi.item_name, mi.description, mi.price, mi.image,
               mi.calories, mi.protein, mi.carbohydrates, mi.fat,
               c.category_name, c.category_id
        FROM menu_items mi
        INNER JOIN categories c ON c.category_id = mi.category_id
        WHERE mi.is_available = 1";
$params = [];
if ($categoryId) {
    $sql .= " AND c.category_id = :category_id";
    $params['category_id'] = $categoryId;
}
$sql .= " ORDER BY c.category_name, mi.item_name";
$stmt = $pdo->prepare($sql);
$stmt->execute($params);
$items = $stmt->fetchAll();

